# Copia este archivo como .env y llena los valores de TU proyecto de Supabase.
# .env está en .gitignore: nunca se sube al repositorio.
#
#   Dashboard de Supabase → Project Settings → API
#
# El prefijo EXPO_PUBLIC_ es obligatorio: solo esas variables llegan al bundle
# de la app. Estos dos valores viajan dentro del APK y son públicos por diseño;
# lo que protege los datos son las políticas RLS, no el secreto de la key.
#
# ⚠️ NUNCA pongas aquí la service_role key. Esa salta todas las políticas RLS.

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
